<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    Este item es tu icono.
    - android:drawable apunta a tu vector original.
    - android:gravity="center" lo coloca en el medio del espacio disponible.
    - width y height definen el tamaño final que tendrá en la splash screen.
    -->
    <item
        android:drawable="@drawable/ic_splash_foreground"
        android:gravity="center"
        android:width="30dp"
        android:height="24dp" />

</layer-list>